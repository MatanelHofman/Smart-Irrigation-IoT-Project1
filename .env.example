# Copy this file to ".env" and adjust values for your machine.
# The system works with the defaults below out of the box.

# MQTT broker connection
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=30

# Fixed topic prefix used by every component (do not use a shared/public broker)
MQTT_TOPIC_PREFIX=smart_irrigation/matanel_roy

# SQLite database file (created automatically on first run)
DATABASE_PATH=data/smart_irrigation.sqlite3

# Log file location
LOG_FILE=data/data_manager.log
LOG_LEVEL=INFO
